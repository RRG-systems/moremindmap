        {"id":"fallout_reason_categories","type":"enum_set:CUSTOMER_DROPOFF|INCOMPLETE_APPLICATION|QUALIFICATION_PREAPPROVAL|PROPERTY_SEARCH|PROCESS_APPROVAL|LOCK_FUNDING|CYCLE_DELAY|OTHER|UNKNOWN","required":"OPTIONAL","applicability":"CONDITIONAL_ACTIVE","period_rule":"DECLARED_WINDOW"},
        {"id":"conversion_customer_explanation","type":"string","required":"OPTIONAL","applicability":"CONDITIONAL_ACTIVE","period_rule":"DECLARED_WINDOW"},
        {"id":"fallout_count","type":"integer_nonnegative","required":"OPTIONAL","applicability":"CONDITIONAL_ACTIVE","period_rule":"SAME_AS_TRIGGER"},
        {"id":"cycle_aging_measure","type":"metric_definition","required":"OPTIONAL","applicability":"CONDITIONAL_ACTIVE","period_rule":"SAME_AS_TRIGGER"},
        {"id":"conversion_control_owner","type":"enum:LO|SHARED|PLATFORM|EXTERNAL|UNKNOWN","required":"REQUIRED_IF_CAUSAL_CLAIM","applicability":"CONDITIONAL_ACTIVE","period_rule":"CURRENT_AS_OF_CAPTURE"},
        {"id":"conversion_materiality","type":"enum:MATERIAL|POSSIBLE|IMMATERIAL|UNKNOWN","required":"REQUIRED","applicability":"CONDITIONAL_ACTIVE","period_rule":"CURRENT_AS_OF_CAPTURE"}
      ]
    },
    {
      "id": "LO_COND_14_ECONOMICS",
      "kind": "CONDITIONAL",
      "fields": [
        {"id":"economic_scope","type":"enum:INDIVIDUAL_GROSS|INDIVIDUAL_NET_BUSINESS|TEAM|BRANCH|SALARY_DRAW|OTHER","required":"REQUIRED","applicability":"CONDITIONAL_ACTIVE","period_rule":"TRAILING_AND_FORWARD_12_MONTHS"},
        {"id":"compensation_revenue_basis","type":"string_or_enum","required":"REQUIRED_FOR_CALCULATION","applicability":"CONDITIONAL_ACTIVE","period_rule":"TRAILING_12_MONTHS"},
        {"id":"gross_amount_per_funded_or_period","type":"currency_metric","required":"REQUIRED_FOR_CALCULATION","applicability":"CONDITIONAL_ACTIVE","period_rule":"TRAILING_12_MONTHS"},
        {"id":"variable_business_cost_per_funded","type":"currency_metric","required":"OPTIONAL","applicability":"ECONOMIC_SCOPE_REQUIRES","period_rule":"TRAILING_12_MONTHS"},
        {"id":"fixed_business_cost","type":"currency_metric","required":"OPTIONAL","applicability":"ECONOMIC_SCOPE_REQUIRES","period_rule":"TRAILING_OR_FORWARD_12_MONTHS"},
        {"id":"salary_draw_branch_distinctions","type":"structured_economic_terms","required":"OPTIONAL","applicability":"ECONOMIC_SCOPE_REQUIRES","period_rule":"TRAILING_OR_FORWARD_12_MONTHS"},
        {"id":"economic_currency_units","type":"string","required":"REQUIRED_IF_VALUE_SUPPLIED","applicability":"CONDITIONAL_ACTIVE","period_rule":"NOT_TEMPORAL"},
        {"id":"economic_sustainable_capacity","type":"metric_definition","required":"OPTIONAL","applicability":"FEASIBILITY_TEST","period_rule":"DECLARED_WINDOW"},
        {"id":"economic_assumption_source","type":"provenance_ref","required":"REQUIRED_IF_MODELED","applicability":"CONDITIONAL_ACTIVE","period_rule":"NOT_TEMPORAL"},
        {"id":"economic_sensitivity_range","type":"numeric_range","required":"OPTIONAL","applicability":"MODELED_OR_SCENARIO","period_rule":"FORWARD_12_MONTHS"}
      ]
    },
    {
      "id": "LO_COND_15_CONTRADICTION_CLARIFICATION",
      "kind": "CONDITIONAL",
      "fields": [
        {"id":"contradiction_evidence_ids","type":"evidence_ref_set","required":"REQUIRED","applicability":"CONDITIONAL_ACTIVE","period_rule":"SAME_AS_CONFLICTING_CLAIMS"},
        {"id":"contradiction_type","type":"enum:DEFINITION|PERIOD|COHORT|UNIT|SUBJECT_SCOPE|PURPOSE|ATTRIBUTION|DUPLICATE_VALUE|OTHER","required":"REQUIRED","applicability":"CONDITIONAL_ACTIVE","period_rule":"NOT_TEMPORAL"},
        {"id":"contradiction_explanation","type":"string","required":"OPTIONAL","applicability":"CONDITIONAL_ACTIVE","period_rule":"NOT_TEMPORAL"},
        {"id":"contradiction_corrected_claim","type":"structured_claim","required":"OPTIONAL","applicability":"CUSTOMER_RESOLVES","period_rule":"DECLARED_BY_CORRECTION"},
        {"id":"contradiction_supersession_link","type":"evidence_ref","required":"REQUIRED_IF_CORRECTED","applicability":"CUSTOMER_RESOLVES","period_rule":"NOT_TEMPORAL"},
        {"id":"contradiction_resolution_state","type":"enum:RESOLVED|PARTIALLY_RESOLVED|UNRESOLVED|CUSTOMER_UNSURE","required":"REQUIRED","applicability":"CONDITIONAL_ACTIVE","period_rule":"CURRENT_AS_OF_CAPTURE"},
        {"id":"contradiction_unresolved_reason","type":"string","required":"OPTIONAL","applicability":"UNRESOLVED","period_rule":"NOT_TEMPORAL"}
      ]
    }
  ]
}
