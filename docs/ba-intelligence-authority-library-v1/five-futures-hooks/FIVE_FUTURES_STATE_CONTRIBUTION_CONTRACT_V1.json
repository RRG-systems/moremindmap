      {
        "role_id": "current_course",
        "purpose": "Represent the trajectory already being produced by current state and mechanisms."
      },
      {
        "role_id": "likely_next",
        "purpose": "Represent the next materially distinct trajectory supported if current drivers persist."
      },
      {
        "role_id": "constraint_intensified",
        "purpose": "Represent the consequence when the governing constraint persists or worsens."
      },
      {
        "role_id": "optimized",
        "purpose": "Represent a better conditional trajectory when a bounded high-leverage mover is executed."
      },
      {
        "role_id": "transformational",
        "purpose": "Represent a structurally different model only when evidence supports the distinction."
      }
    ],
