{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/moremindmap/new-bos.js": {
      "maxDuration": 800
    },
    "api/moremindmap/new-ba.js": {
      "maxDuration": 800,
      "includeFiles": "{api/engine/newBaProductionReadinessV1/pinnedAuthority/**,docs/ba-intelligence-authority-library-v1/**}"
    },
    "api/moremindmap/new-ba-generation.js": {
      "maxDuration": 800,
      "includeFiles": "{api/engine/newBaProductionReadinessV1/pinnedAuthority/**,docs/ba-intelligence-authority-library-v1/**}"
    },
    "api/internal/subscription-v1-runtime.js": {
      "maxDuration": 800
    },
    "api/**/*.js": {
      "maxDuration": 180
    }
  }
}
