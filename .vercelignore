# Release 3 carries sealed predecessor modules only so their protected local
# regression suites remain reproducible. They are not runtime dependencies of
# the governed one-shot Athlete Consulting route and must never become Vercel
# API function candidates.
api/engine/athleteBosV1/**
api/engine/athleteLivingConsultV1/**

# The frozen BA authority library is runtime input for canonical New BA. Keep
# this final so the global markdown/text exclusions above cannot remove it.
!docs/ba-intelligence-authority-library-v1/
!docs/ba-intelligence-authority-library-v1/**

# Release 4 Subscription validates the sealed source library and Loan
# Originator authority at runtime. Keep these final so the global markdown and
# text exclusions above cannot remove required server-only custody inputs.
!api/engine/subscriptionV1/sourceLibrary/
!api/engine/subscriptionV1/sourceLibrary/**
!docs/lo-cassette-2-final-canonical-authority-v1/
!docs/lo-cassette-2-final-canonical-authority-v1/**
