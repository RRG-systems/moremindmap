+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  ASYNC_SECURITY_STATE_CONTRACT_VERSION,
+  PROTECTED_EDGE_IDENTITY_ADAPTER_ID,
+  PROTECTED_EDGE_IDENTITY_BINDING_CONTRACT_VERSION,
