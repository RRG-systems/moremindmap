+  if (stat.isDirectory()) {
+    for (const name of fs.readdirSync(candidate).sort()) {
+      walk(path.join(candidate, name), files);
+    }
+  } else if (stat.isFile()) {
+    files.push(candidate);
+  }
+  return files;
+}
